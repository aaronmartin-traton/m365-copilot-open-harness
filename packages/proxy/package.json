  "dependencies": {
    "@m365-copilot/core": "workspace:*",
    "@m365-copilot/proxy-lib": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nitropack": "^2.10.4"
  },
  "publishConfig": {
    "access": "public"
