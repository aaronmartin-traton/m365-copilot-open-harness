{
  "name": "@m365-copilot/proxy-lib",
  "version": "0.2.0",
  "description": "OpenAI-compatible translation layer for the M365 Copilot proxy: request handling, session pooling and fenced tool-call parsing.",
  "license": "MIT",
  "author": "asmartin-ai",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronmartin-traton/m365-copilot-open-harness.git",
    "directory": "packages/proxy-lib"
  },
  "homepage": "https://github.com/aaronmartin-traton/m365-copilot-open-harness#readme",
  "bugs": {
    "url": "https://github.com/aaronmartin-traton/m365-copilot-open-harness/issues"
  },
  "keywords": [
    "m365",
    "microsoft-365",
    "copilot",
    "openai",
    "proxy",
    "openai-compatible",
    "reverse-engineering"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@m365-copilot/chatgpt-web": "workspace:*",
    "@m365-copilot/core": "workspace:*",
    "zod": "^4.3.6"
