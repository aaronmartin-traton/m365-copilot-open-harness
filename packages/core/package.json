{
  "name": "@m365-copilot/core",
  "version": "0.2.0",
  "description": "Core primitives for the M365 Copilot proxy: browser sign-in, the SignalR/WebSocket client, sessions, agent management and tool formatting.",
  "license": "MIT",
  "author": "asmartin-ai",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronmartin-traton/m365-copilot-open-harness.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aaronmartin-traton/m365-copilot-open-harness#readme",
  "bugs": {
    "url": "https://github.com/aaronmartin-traton/m365-copilot-open-harness/issues"
  },
  "keywords": [
    "m365",
    "microsoft-365",
    "copilot",
    "openai",
    "proxy",
    "signalr",
    "reverse-engineering"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts"
  },
  "dependencies": {
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
